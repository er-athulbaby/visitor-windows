<Window x:Class="ServiceGatePass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Title="Service Gate Pass" Width="1280" Height="800" WindowState="Maximized" FontSize="16">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserName" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="LanguageButton" Click="Language_Click" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="{l:T 'Log out'}" Click="Logout_Click" Padding="10,4"/>
                </StackPanel>
                <Image x:Name="Logo" FlowDirection="LeftToRight" Height="40" Margin="0,0,12,0"/>
                <TextBlock x:Name="HotelName" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border x:Name="BannerBar" DockPanel.Dock="Top" Background="#FEF3C7" Padding="12,6" Visibility="Collapsed">
            <TextBlock x:Name="Banner" Foreground="#92400E" TextWrapping="Wrap"/>
        </Border>
        <TabControl x:Name="Tabs" Margin="8"/>
    </DockPanel>
</Window>
