<Window x:Class="ServiceGatePass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Style="{StaticResource AppWindow}"
        Title="Service Gate Pass" Width="1366" Height="768" MinWidth="1100" MinHeight="640" WindowState="Maximized">
    <Grid>
        <!-- The TabControl draws the navy strip (nav items) and the page area; role gating stays in code. -->
        <TabControl x:Name="Tabs" Style="{StaticResource SidebarTabs}">
            <TabControl.Tag>
                <Border x:Name="BannerBar" Background="{StaticResource AmberBrush}" BorderBrush="{StaticResource AmberBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="28,10" Visibility="Collapsed"
                        TextElement.Foreground="{StaticResource AmberTextBrush}">
                    <DockPanel>
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconAlert}"/>
                        </Viewbox>
                        <TextBlock x:Name="Banner" TextWrapping="Wrap" FontWeight="Medium" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </TabControl.Tag>
        </TabControl>

        <!-- Sidebar header and footer, drawn over the TabControl's navy strip (no background, so the nav stays clickable). -->
        <Grid Width="220" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="22,24,14,0" VerticalAlignment="Top">
                <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Control x:Name="BrandMark" Style="{StaticResource BrandMark}"/>
                    <Border x:Name="LogoTile" Style="{StaticResource LogoTile}">
                        <Image x:Name="Logo" FlowDirection="LeftToRight" Height="28" MaxWidth="56" Stretch="Uniform"/>
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HotelName" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{l:T 'Service gate'}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="12"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="2" Margin="14,0,14,16">
                <Border BorderBrush="{StaticResource SidebarDividerBrush}" BorderThickness="0,1,0,0" Padding="8,14,0,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Background="{StaticResource NavSelectedBrush}" Margin="0,0,10,0">
                            <TextBlock x:Name="UserInitials" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="LanguageButton" DockPanel.Dock="Right" Style="{StaticResource SidebarButton}" Click="Language_Click"
                                VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserName" Foreground="White" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="UserRole" Foreground="{StaticResource SidebarMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource SidebarNavButton}" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLogout}"/>
                        </Viewbox>
                        <TextBlock Text="{l:T 'Log out'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
