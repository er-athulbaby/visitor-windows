<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:ServiceGatePass">

    <!-- ===== Colours (docs/design/service-gate-ui) ===== -->
    <Color x:Key="AccentColor">#0E7C82</Color>
    <SolidColorBrush x:Key="PageBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E8EE"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F2A3D"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#163A52"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1B4058"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#C9D7E3"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8FA6B8"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#1F4560"/>
    <SolidColorBrush x:Key="SidebarButtonBorderBrush" Color="#2B5674"/>
    <SolidColorBrush x:Key="InkBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6B7A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7B8A98"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D5DCE3"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#B8C3CE"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="HoverFillBrush" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B6A6F"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#09585C"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#ECF7F7"/>
    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#DDF0F0"/>
    <SolidColorBrush x:Key="AccentTintBorderBrush" Color="#9CCFD1"/>
    <SolidColorBrush x:Key="OnTintBrush" Color="#0A4F54"/>
    <SolidColorBrush x:Key="OnTintSecondaryBrush" Color="#3E6B6E"/>
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#330E7C82"/>
    <SolidColorBrush x:Key="DarkBrush" Color="#0F2A3D"/>
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#1B4058"/>
    <SolidColorBrush x:Key="DarkPressedBrush" Color="#0A1F2D"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFF6E5"/>
    <SolidColorBrush x:Key="AmberBorderBrush" Color="#F5D9A8"/>
    <SolidColorBrush x:Key="AmberTextBrush" Color="#7A4B00"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1C6B3F"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#E8F5EE"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="ChartBarBrush" Color="#B9D6D8"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===== Icons: 24x24 stroke paths (same drawings as the mockups) ===== -->
    <Geometry x:Key="IconShield">M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z M9 12l2 2 4-4</Geometry>
    <Geometry x:Key="IconGate">M3 21h18 M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16 M14 12h.01</Geometry>
    <Geometry x:Key="IconHistory">M12 8v4l3 2 M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0</Geometry>
    <Geometry x:Key="IconDashboard">M4 20V10 M10 20V4 M16 20v-7 M22 20H2</Geometry>
    <Geometry x:Key="IconSettings">M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1 .1a2 2 0 1 1 -2.8 2.8l-.1 -.1a1.7 1.7 0 0 0 -1.8 -.3 1.7 1.7 0 0 0 -1 1.5V21a2 2 0 1 1 -4 0v-.1a1.7 1.7 0 0 0 -1.1 -1.5 1.7 1.7 0 0 0 -1.8 .3l-.1 .1a2 2 0 1 1 -2.8 -2.8l.1 -.1a1.7 1.7 0 0 0 .3 -1.8 1.7 1.7 0 0 0 -1.5 -1H3a2 2 0 1 1 0 -4h.1a1.7 1.7 0 0 0 1.5 -1.1 1.7 1.7 0 0 0 -.3 -1.8l-.1 -.1a2 2 0 1 1 2.8 -2.8l.1 .1a1.7 1.7 0 0 0 1.8 .3H9a1.7 1.7 0 0 0 1 -1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8 -.3l.1 -.1a2 2 0 1 1 2.8 2.8l-.1 .1a1.7 1.7 0 0 0 -.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0 -1.5 1z</Geometry>
    <Geometry x:Key="IconUsers">M16 21v-2a4 4 0 0 0 -4 -4H6a4 4 0 0 0 -4 4v2 M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M22 21v-2a4 4 0 0 0 -3 -3.87 M16 3.13a4 4 0 0 1 0 7.75</Geometry>
    <Geometry x:Key="IconCard">M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V7a2 2 0 0 1 2 -2z M7 11a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M6 15c.6 -1.2 1.7 -2 3 -2s2.4 .8 3 2 M14 10h4 M14 13h3</Geometry>
    <Geometry x:Key="IconPerson">M8 8a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M4 21c1.5 -4 4.5 -6 8 -6s6.5 2 8 6</Geometry>
    <Geometry x:Key="IconSearch">M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-4.3 -4.3</Geometry>
    <Geometry x:Key="IconCheckCircle">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M8 12l3 3 5 -6</Geometry>
    <Geometry x:Key="IconAlert">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 8v5 M12 16h.01</Geometry>
    <Geometry x:Key="IconLogout">M9 21H5a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2h4 M16 17l5 -5 -5 -5 M21 12H9</Geometry>
    <Geometry x:Key="IconChevronDown">M6 9l6 6 6 -6</Geometry>
    <Geometry x:Key="IconArrowUp">M12 19V5 M5 12l7 -7 7 7</Geometry>
    <Geometry x:Key="IconArrowDown">M12 5v14 M19 12l-7 7 -7 -7</Geometry>
    <Geometry x:Key="IconCalendar">M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V7a2 2 0 0 1 2 -2z M16 3v4 M8 3v4 M3 11h18</Geometry>
    <Geometry x:Key="IconImage">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2z M8 10a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0 M21 15l-5 -5L5 21</Geometry>

    <!-- Place inside a Viewbox; the stroke takes the inherited text colour. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- ===== Focus rings (keyboard focus only) ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="13" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingLight">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentTintBorderBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Windows and text ===== -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource PageBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Status line: the code sets Text, Foreground and Tag ("ok" / "error"). Takes no space while empty. -->
    <Style x:Key="MessageText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 18px icon beside a MessageText; set DataContext to that TextBlock. -->
    <Style x:Key="MessageIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Stroke" Value="{Binding Foreground}"/>
        <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag}" Value="error">
                <Setter Property="Data" Value="{StaticResource IconAlert}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource DarkBrush}"/>
    </Style>
    <Style x:Key="StatTileAmber" TargetType="Border" BasedOn="{StaticResource StatTile}">
        <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AmberTextBrush}"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Background" Value="{StaticResource SuccessTintBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="AmberPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AmberTextBrush}"/>
    </Style>
    <Style x:Key="GreyPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="#F1F3F5"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <!-- Keyboard hint chip, e.g. F2 / Enter. -->
    <Style x:Key="KeyChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentTintBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnTintBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Square accent mark with the shield, used when there is no hotel logo.
         Use as <Control Style="{StaticResource BrandMark}"/>. -->
    <Style x:Key="BrandMark" TargetType="Control">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border CornerRadius="10" Background="{StaticResource AccentBrush}" TextElement.Foreground="White">
                        <Viewbox Margin="8">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}"/>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- White tile that holds a hotel logo on the navy panels. -->
    <Style x:Key="LogoTile" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <ControlTemplate x:Key="ButtonChrome" TargetType="ButtonBase">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ButtonChromeLarge" TargetType="ButtonBase">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default button = secondary: white with a grey border. -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource ButtonChrome}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverFillBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource DarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DarkHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DarkPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template" Value="{StaticResource ButtonChromeLarge}"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="22,0"/>
    </Style>
    <Style x:Key="LargeDarkButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
        <Setter Property="Template" Value="{StaticResource ButtonChromeLarge}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="22,0"/>
    </Style>
    <!-- Square button holding one icon (location up / down). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- Outline button on the navy sidebar (language). -->
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource SidebarButtonBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingLight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SidebarMutedBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource NavSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Borderless row on the sidebar that looks like a nav item (Log out). -->
    <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <!-- The big dashed "Read CPR card" button. -->
    <Style x:Key="ReadCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Rectangle RadiusX="14" RadiusY="14" Fill="{TemplateBinding Background}"
                                   Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeDashArray="3 2"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CFE9EA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Text inputs ===== -->
    <!-- TextBox: Tag is shown as a placeholder while the box is empty. -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="Transparent"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="{TemplateBinding Padding}" Padding="2,0" TextAlignment="{TemplateBinding TextAlignment}" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="12,9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Field for Latin or number data (CPR, names, company, URLs). In Arabic it stays
         left-to-right, so punctuation lands correctly, but is right-aligned like the layout. -->
    <Style x:Key="LatinTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static l:L.IsArabic}}" Value="True">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Search field with a magnifier at the start (the right edge in Arabic). -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource LatinTextBox}">
        <Setter Property="Padding" Value="36,0,12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="Transparent"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <Viewbox x:Name="Glass" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0"
                                         TextElement.Foreground="{StaticResource MutedTextBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}"/>
                                </Viewbox>
                                <Grid>
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="{TemplateBinding Padding}" Padding="2,0" TextAlignment="{TemplateBinding TextAlignment}" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static l:L.IsArabic}}" Value="True">
                            <Setter TargetName="Glass" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Glass" Property="Margin" Value="0,0,12,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static l:L.IsArabic}}" Value="True">
                <Setter Property="Padding" Value="12,0,36,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="Transparent"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnTintBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,0,34,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="Transparent"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,12,0"
                                     TextElement.Foreground="{StaticResource MutedTextBrush}">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconChevronDown}"/>
                            </Viewbox>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Margin="0,0,8,8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12" Color="#0F2A3D"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Glow" Margin="-3" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent"/>
                            <Border x:Name="Box" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource InputHoverBorderBrush}"
                                    Background="{StaticResource CardBrush}"/>
                            <Path x:Name="Tick" Data="M4.5 9.5l3 3 6 -7" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DatePicker ===== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Calendar's own header buttons must not pick up the app's Button look. -->
    <Style TargetType="Calendar">
        <Style.Resources>
            <Style TargetType="Button"/>
        </Style.Resources>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="Transparent"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Margin="12,0,4,0" VerticalAlignment="Center" Focusable="{TemplateBinding Focusable}"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand" Margin="0,0,6,0"
                                        Width="30" Height="30" TextElement.Foreground="{StaticResource MutedTextBrush}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="8">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCalendar}"/>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource SubtleFillBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource FocusGlowBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scroll bars: thin, no arrows ===== -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#C5CED7" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#9AA8B5"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#7B8A98"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== DataGrid ===== -->
    <Style x:Key="ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path x:Name="Arrow" Margin="6,0,0,0" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{StaticResource MutedTextBrush}" Data="M0 0 L4 5 L8 0z" Visibility="Collapsed"/>
                        </StackPanel>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Arrow" Property="Data" Value="M0 5 L4 0 L8 5z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0">
                        <DataGridCellsPresenter MinHeight="{TemplateBinding MinHeight}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverFillBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Gate "Inside now" rows: separate rounded cards; the selected one is tinted. -->
    <Style x:Key="CardRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Margin="0,0,0,6">
                        <DataGridCellsPresenter MinHeight="{TemplateBinding MinHeight}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverFillBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentTintBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <!-- Text showing Latin or number data: left-to-right but right-aligned in Arabic (see LatinTextBox). -->
    <Style x:Key="LatinText" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static l:L.IsArabic}}" Value="True">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Grid cell holding translated text (role, yes/no): follows the page direction. -->
    <Style x:Key="CellLocal" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Grid cell holding data. -->
    <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource LatinText}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    </Style>
    <Style x:Key="CellStrong" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource DarkBrush}"/>
    </Style>

    <!-- ===== Lists ===== -->
    <!-- ListBox without its own ScrollViewer, so the page scrolls with the mouse wheel. -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Gate location tile: selected = accent border + tint. -->
    <Style x:Key="LocationTile" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#24323F"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource InputBorderBrush}"
                            Background="{StaticResource CardBrush}" Padding="8,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentTintBorderBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnTintBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Settings-style list row. -->
    <Style x:Key="CardListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource RowDividerBrush}"
                            Background="{StaticResource CardBrush}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentTintBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thin progress bar (dashboard top lists) ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource DarkBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Main window sidebar: the TabControl draws the navy strip and the page area ===== -->
    <Style x:Key="NavTab" TargetType="TabItem">
        <!-- Nav colours live on the template border; the page content inherits Foreground from the TabItem. -->
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingLight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="10" Padding="12,11" Background="Transparent" SnapsToDevicePixels="True"
                            TextElement.Foreground="{StaticResource NavTextBrush}" TextElement.FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon}" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Viewbox>
                            <ContentPresenter ContentSource="Header" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White"/>
                            <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="Medium"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Tag = an element shown above the page (the backup banner). The sidebar's
         header and footer are drawn over the strip by MainWindow. -->
    <Style x:Key="SidebarTabs" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavTab}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}">
                            <StackPanel IsItemsHost="True" Margin="14,80,14,0" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <DockPanel Grid.Column="1" Background="{StaticResource PageBrush}">
                            <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Tag}"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
