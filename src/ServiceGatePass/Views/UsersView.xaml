<UserControl x:Class="ServiceGatePass.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Right" Width="300" Margin="12,0,0,0">
            <TextBlock Text="{l:T 'Username'}"/>
            <TextBox x:Name="UsernameBox"/>
            <TextBlock Text="{l:T 'Display name'}" Margin="0,8,0,0"/>
            <TextBox x:Name="DisplayNameBox"/>
            <TextBlock Text="{l:T 'Password'}" Margin="0,8,0,0"/>
            <PasswordBox x:Name="PasswordInput"/>
            <TextBlock Text="{l:T 'Role'}" Margin="0,8,0,0"/>
            <ComboBox x:Name="RoleBox" SelectedIndex="0">
                <ComboBoxItem Content="{l:T 'Gate staff'}"/>
                <ComboBoxItem Content="{l:T 'Admin'}"/>
            </ComboBox>
            <Button Content="{l:T 'Add user'}" Click="Add_Click" Padding="10,6" Margin="0,12,0,0"/>
            <TextBlock Text="{l:T 'For the selected user:'}" FontWeight="Bold" Margin="0,16,0,4"/>
            <Button Content="{l:T 'Reset password'}" Click="Reset_Click" Padding="10,6" Margin="0,0,0,6"/>
            <Button Content="{l:T 'Enable / disable'}" Click="Toggle_Click" Padding="10,6" Margin="0,0,0,6"/>
            <Button Content="{l:T 'Make admin'}" Click="MakeAdmin_Click" Padding="10,6" Margin="0,0,0,6"/>
            <Button Content="{l:T 'Make gate staff'}" Click="MakeGate_Click" Padding="10,6"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T 'Username'}" Binding="{Binding Username}"/>
                <DataGridTextColumn Header="{l:T 'Display name'}" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="{l:T 'Role'}" Binding="{Binding RoleText}"/>
                <DataGridTextColumn Header="{l:T 'Active'}" Binding="{Binding ActiveText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
