<UserControl x:Class="ServiceGatePass.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <DockPanel Margin="28,24">
        <TextBlock DockPanel.Dock="Top" Text="{l:T 'Users'}" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

        <!-- Add user and actions for the selected user -->
        <ScrollViewer DockPanel.Dock="Right" Width="340" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Add user'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="{l:T 'Username'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameBox"/>
                        <TextBlock Text="{l:T 'Display name'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                        <TextBox x:Name="DisplayNameBox"/>
                        <TextBlock Text="{l:T 'Password'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                        <PasswordBox x:Name="PasswordInput"/>
                        <TextBlock Text="{l:T 'Role'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="RoleBox" SelectedIndex="0">
                            <ComboBoxItem Content="{l:T 'Gate staff'}"/>
                            <ComboBoxItem Content="{l:T 'Admin'}"/>
                        </ComboBox>
                        <Button Content="{l:T 'Add user'}" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{l:T 'For the selected user:'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Margin="0,0,-8,-8">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </UniformGrid.Resources>
                            <Button Content="{l:T 'Reset password'}" Click="Reset_Click"/>
                            <Button Content="{l:T 'Enable / disable'}" Click="Toggle_Click"/>
                            <Button Content="{l:T 'Make admin'}" Click="MakeAdmin_Click"/>
                            <Button Content="{l:T 'Make gate staff'}" Click="MakeGate_Click"/>
                        </UniformGrid>
                        <TextBlock Text="{l:T 'Reset password uses the Password field above.'}" Style="{StaticResource SecondaryText}"
                                   FontSize="12" Margin="0,10,0,0"/>
                        <TextBlock x:Name="MessageText" Style="{StaticResource MessageText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- User list -->
        <Border Style="{StaticResource Card}" Padding="4,4,4,0">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Display name'}" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource CellStrong}"/>
                    <DataGridTextColumn Header="{l:T 'Username'}" Binding="{Binding Username}" Width="*" ElementStyle="{StaticResource CellMuted}"/>
                    <DataGridTextColumn Header="{l:T 'Role'}" Binding="{Binding RoleText}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="{l:T 'Active'}" Width="Auto" MinWidth="90" SortMemberPath="IsActive">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pill" Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding ActiveText}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="Pill" Property="Style" Value="{StaticResource GreyPill}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
