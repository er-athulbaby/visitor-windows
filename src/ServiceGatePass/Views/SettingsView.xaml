<UserControl x:Class="ServiceGatePass.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <DockPanel Margin="28,24">
            <!-- Title, status, Save -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="{l:T 'Save'}" Click="Save_Click" Style="{StaticResource PrimaryButton}" Padding="22,0"/>
                <TextBlock x:Name="MessageText" DockPanel.Dock="Right" Style="{StaticResource MessageText}" Margin="12,0" MaxWidth="420"/>
                <TextBlock Text="{l:T 'Settings'}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Hotel -->
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Hotel'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <TextBlock Text="{l:T 'Hotel name'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HotelNameBox"/>
                            <TextBlock Text="{l:T 'Logo'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="56" Height="56" Margin="0,0,12,0">
                                    <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource SubtleFillBrush}" Stroke="{StaticResource InputHoverBorderBrush}"
                                               StrokeDashArray="4 3"/>
                                    <Image x:Name="LogoImage" FlowDirection="LeftToRight" Margin="6" Stretch="Uniform"/>
                                </Grid>
                                <Button Content="{l:T 'Choose…'}" Click="ChooseLogo_Click" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- At the gate -->
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{l:T 'At the gate'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="BadgeBox" Content="{l:T 'Use badge numbers'}"/>
                            <CheckBox x:Name="SlotBox" Content="{l:T 'Use card slot numbers'}" Margin="0,14,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{l:T 'Number of slots'}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox x:Name="SlotCountBox" Style="{StaticResource LatinTextBox}" Width="80" MinHeight="36" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'Card reader URL'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBox x:Name="ReaderBox" FontSize="13" Style="{StaticResource LatinTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Backups -->
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Backups'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="{l:T 'Backup folder'}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T 'Choose…'}" Click="ChooseFolder_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="BackupBox" Style="{StaticResource LatinTextBox}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Locations -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{l:T 'Locations'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Name (English)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LocNameBox" Style="{StaticResource LatinTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'Name (Arabic)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LocNameArBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{l:T 'Add'}" Click="AddLocation_Click" Style="{StaticResource DarkButton}" MinHeight="36" Margin="0,0,8,8"/>
                                <Button Content="{l:T 'Rename'}" Click="RenameLocation_Click" MinHeight="36" Margin="0,0,8,8"/>
                                <Button Click="Up_Click" Style="{StaticResource IconButton}" MinHeight="36" Margin="0,0,8,8"
                                        ToolTip="{l:T 'Up'}" AutomationProperties.Name="{l:T 'Up'}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowUp}"/>
                                    </Viewbox>
                                </Button>
                                <Button Click="Down_Click" Style="{StaticResource IconButton}" MinHeight="36" Margin="0,0,8,8"
                                        ToolTip="{l:T 'Down'}" AutomationProperties.Name="{l:T 'Down'}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowDown}"/>
                                    </Viewbox>
                                </Button>
                                <Button Content="{l:T 'Hide / show'}" Click="ToggleLocation_Click" MinHeight="36" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>

                        <ListBox x:Name="LocationsList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardListItem}"
                                 SelectionChanged="LocationsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel x:Name="Row">
                                        <Border x:Name="HiddenPill" DockPanel.Dock="Right" Style="{StaticResource GreyPill}" Margin="10,0,0,0" Visibility="Collapsed">
                                            <TextBlock Text="{l:T 'Hidden'}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding NameAr}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   FlowDirection="RightToLeft" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NameText" Style="{StaticResource LatinText}" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="HiddenPill" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
