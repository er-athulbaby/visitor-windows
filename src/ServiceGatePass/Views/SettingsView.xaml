<UserControl x:Class="ServiceGatePass.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{l:T 'Hotel name'}"/>
                <TextBox x:Name="HotelNameBox"/>
                <TextBlock Text="{l:T 'Logo'}" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:T 'Choose…'}" Click="ChooseLogo_Click" Padding="10,4"/>
                    <Image x:Name="LogoImage" FlowDirection="LeftToRight" Height="40" Margin="12,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="BadgeBox" Content="{l:T 'Use badge numbers'}" Margin="0,12,0,0"/>
                <CheckBox x:Name="SlotBox" Content="{l:T 'Use card slot numbers'}" Margin="0,8,0,0"/>
                <TextBlock Text="{l:T 'Number of slots'}" Margin="0,8,0,0"/>
                <TextBox x:Name="SlotCountBox" Width="100" HorizontalAlignment="Left"/>
                <TextBlock Text="{l:T 'Backup folder'}" Margin="0,12,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T 'Choose…'}" Click="ChooseFolder_Click" Padding="10,4" Margin="8,0,0,0"/>
                    <TextBox x:Name="BackupBox"/>
                </DockPanel>
                <TextBlock Text="{l:T 'Card reader URL'}" Margin="0,12,0,0"/>
                <TextBox x:Name="ReaderBox"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Button Content="{l:T 'Save'}" Click="Save_Click" Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:T 'Locations'}" FontWeight="Bold"/>
                <ListBox x:Name="LocationsList" Height="300" SelectionChanged="LocationsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding NameAr}" Margin="12,0,0,0" Foreground="Gray"/>
                                <TextBlock Text="{l:T '(hidden)'}" Margin="12,0,0,0" Foreground="DarkRed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{l:T 'Name (English)'}" Margin="0,8,0,0"/>
                <TextBox x:Name="LocNameBox"/>
                <TextBlock Text="{l:T 'Name (Arabic)'}"/>
                <TextBox x:Name="LocNameArBox" FlowDirection="RightToLeft"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{l:T 'Add'}" Click="AddLocation_Click" Padding="10,4" Margin="0,0,6,6"/>
                    <Button Content="{l:T 'Rename'}" Click="RenameLocation_Click" Padding="10,4" Margin="0,0,6,6"/>
                    <Button Content="{l:T 'Up'}" Click="Up_Click" Padding="10,4" Margin="0,0,6,6"/>
                    <Button Content="{l:T 'Down'}" Click="Down_Click" Padding="10,4" Margin="0,0,6,6"/>
                    <Button Content="{l:T 'Hide / show'}" Click="ToggleLocation_Click" Padding="10,4" Margin="0,0,6,6"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
