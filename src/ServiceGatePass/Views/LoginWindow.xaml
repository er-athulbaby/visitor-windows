<Window x:Class="ServiceGatePass.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Title="Service Gate Pass" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="16">
    <StackPanel Margin="24">
        <Image x:Name="LogoImage" FlowDirection="LeftToRight" Height="60" Margin="0,0,0,8"/>
        <TextBlock x:Name="HotelNameText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{l:T 'Username'}"/>
        <TextBox x:Name="UsernameBox"/>
        <TextBlock Text="{l:T 'Password'}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="PasswordInput"/>
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button Content="{l:T 'Sign in'}" Click="SignIn_Click" IsDefault="True" Padding="16,8" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
