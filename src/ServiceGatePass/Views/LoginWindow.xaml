<Window x:Class="ServiceGatePass.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Style="{StaticResource AppWindow}"
        Title="Service Gate Pass" Width="1040" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Navy brand panel -->
        <Border Background="{StaticResource SidebarBrush}" Padding="48">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                        <Control x:Name="BrandMark" Style="{StaticResource BrandMark}" Width="44" Height="44"/>
                        <Border x:Name="LogoTile" Style="{StaticResource LogoTile}" Visibility="Collapsed">
                            <Image x:Name="LogoImage" FlowDirection="LeftToRight" Height="36" MaxWidth="120" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Service Gate Pass" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" TextElement.Foreground="{StaticResource NavTextBrush}">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="InsideNowText" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{l:T 'Inside now'}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="VisitsTodayText" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{l:T 'Visits today'}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HotelNameText" Foreground="{StaticResource SidebarMutedBrush}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{l:T 'Know whose card you’re holding, every minute.'}" Foreground="White" FontSize="36" FontWeight="Bold"
                               TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" LineHeight="42"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sign-in form -->
        <StackPanel Grid.Column="1" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{l:T 'Sign in'}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="{l:T 'Use your gate staff account.'}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>

            <TextBlock Text="{l:T 'Username'}" FontSize="13" FontWeight="Medium" Foreground="#3B4A58" Margin="0,24,0,6"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource LatinTextBox}" MinHeight="46" FontSize="15"/>
            <TextBlock Text="{l:T 'Password'}" FontSize="13" FontWeight="Medium" Foreground="#3B4A58" Margin="0,16,0,6"/>
            <PasswordBox x:Name="PasswordInput" MinHeight="46" FontSize="15"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0"/>
            <Button Content="{l:T 'Sign in'}" Click="SignIn_Click" IsDefault="True" Style="{StaticResource LargePrimaryButton}"
                    MinHeight="50" Margin="0,18,0,0"/>
        </StackPanel>
    </Grid>
</Window>
