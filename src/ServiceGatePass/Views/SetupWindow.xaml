<Window x:Class="ServiceGatePass.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Style="{StaticResource AppWindow}"
        Title="Service Gate Pass" Width="1080" Height="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Navy brand panel, as on Sign in -->
        <Border Background="{StaticResource SidebarBrush}" Padding="48">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Control Style="{StaticResource BrandMark}" Width="44" Height="44" Margin="0,0,12,0"/>
                    <TextBlock Text="Service Gate Pass" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{l:T 'You can change all of this later in Settings.'}"
                           Foreground="{StaticResource NavTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{l:T 'Know whose card you’re holding, every minute.'}" Foreground="White" FontSize="34" FontWeight="Bold"
                           TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left" VerticalAlignment="Center" LineHeight="40"/>
            </DockPanel>
        </Border>

        <!-- Form card -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Style="{StaticResource Card}" Padding="28" Margin="36,28" MaxWidth="520" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{l:T 'Set up Service Gate Pass'}" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>

                    <TextBlock Text="{l:T 'Hotel name'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="HotelNameBox"/>

                    <TextBlock Text="{l:T 'Logo (optional)'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="56" Height="56" Margin="0,0,12,0">
                            <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource SubtleFillBrush}" Stroke="{StaticResource InputHoverBorderBrush}"
                                       StrokeDashArray="4 3"/>
                            <Image x:Name="LogoPreview" FlowDirection="LeftToRight" Margin="6" Stretch="Uniform"/>
                        </Grid>
                        <Button Content="{l:T 'Choose…'}" Click="ChooseLogo_Click" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{l:T 'Locations (one per line)'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <TextBox x:Name="LocationsBox" AcceptsReturn="True" Height="112" VerticalScrollBarVisibility="Auto"
                             Text="Kitchen&#10;Ballroom&#10;Loading bay&#10;Stores&#10;Engineering"/>

                    <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16"/>
                    <TextBlock Text="{l:T 'First admin account'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Username'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource LatinTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T 'Display name'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DisplayNameBox"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{l:T 'Password'}" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PasswordInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{l:T 'Confirm password'}" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="ConfirmInput"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,14,0,0"/>
                    <Button Content="{l:T 'Finish'}" Click="Finish_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Padding="28,0" Margin="0,18,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
