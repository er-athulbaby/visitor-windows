<Window x:Class="ServiceGatePass.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ServiceGatePass"
        Title="Service Gate Pass" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="16">
    <StackPanel Margin="20">
        <TextBlock Text="{l:T 'Set up Service Gate Pass'}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{l:T 'Hotel name'}"/>
        <TextBox x:Name="HotelNameBox"/>
        <TextBlock Text="{l:T 'Logo (optional)'}" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="{l:T 'Choose…'}" Click="ChooseLogo_Click" Padding="10,4"/>
            <Image x:Name="LogoPreview" Height="40" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{l:T 'Locations (one per line)'}" Margin="0,8,0,0"/>
        <TextBox x:Name="LocationsBox" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto"
                 Text="Kitchen&#10;Ballroom&#10;Loading bay&#10;Stores&#10;Engineering"/>
        <TextBlock Text="{l:T 'First admin account'}" FontWeight="Bold" Margin="0,12,0,0"/>
        <TextBlock Text="{l:T 'Username'}"/>
        <TextBox x:Name="UsernameBox"/>
        <TextBlock Text="{l:T 'Display name'}"/>
        <TextBox x:Name="DisplayNameBox"/>
        <TextBlock Text="{l:T 'Password'}"/>
        <PasswordBox x:Name="PasswordInput"/>
        <TextBlock Text="{l:T 'Confirm password'}"/>
        <PasswordBox x:Name="ConfirmInput"/>
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button Content="{l:T 'Finish'}" Click="Finish_Click" IsDefault="True" Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
