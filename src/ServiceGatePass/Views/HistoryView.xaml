<UserControl x:Class="ServiceGatePass.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <DockPanel Margin="28,24">
        <!-- Title and output actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{l:T 'Export CSV'}" Click="Export_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{l:T 'Print'}" Click="Print_Click"/>
            <TextBlock Text="{l:T 'History'}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,14,4,14" Margin="0,0,0,16">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="0,0,10,0"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                    </Style>
                </WrapPanel.Resources>
                <StackPanel>
                    <TextBlock Text="{l:T 'From'}" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="FromDate" Width="150"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T 'To'}" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="ToDate" Width="150"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T 'Name or CPR'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SearchBox" Width="210"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T 'Location'}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LocationBox" Width="170" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T 'Company'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CompanyBox" Width="170"/>
                </StackPanel>
                <StackPanel>
                    <Button Content="{l:T 'Show'}" Click="Show_Click" Style="{StaticResource DarkButton}" Padding="18,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Results -->
        <Border Style="{StaticResource Card}" Padding="4,4,4,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                </Border>
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Visitor'}" Binding="{Binding Name}" MinWidth="160" ElementStyle="{StaticResource CellStrong}"/>
                        <DataGridTextColumn Header="{l:T 'CPR'}" Binding="{Binding Cpr}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{l:T 'Location'}" Binding="{Binding Location}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{l:T 'Company'}" Binding="{Binding Company}" MinWidth="140" MaxWidth="260" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{l:T 'Note'}" Binding="{Binding Note}" MinWidth="120" MaxWidth="260" ElementStyle="{StaticResource CellMuted}"/>
                        <DataGridTextColumn Header="{l:T 'Badge #'}" Binding="{Binding BadgeNo}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{l:T 'Slot #'}" Binding="{Binding SlotNo}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{l:T 'In'}" Binding="{Binding CheckInAt, StringFormat='yyyy-MM-dd HH:mm'}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="{l:T 'Out'}" SortMemberPath="CheckOutAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="OutText" Text="{Binding CheckOutAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                        <Border x:Name="InsidePill" Style="{StaticResource AmberPill}" Visibility="Collapsed">
                                            <TextBlock Text="{l:T 'Inside'}"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CheckOutAt}" Value="{x:Null}">
                                            <Setter TargetName="InsidePill" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="OutText" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T 'Checked in by'}" Binding="{Binding CheckInBy}" ElementStyle="{StaticResource CellMuted}"/>
                        <DataGridTextColumn Header="{l:T 'Checked out by'}" Binding="{Binding CheckOutBy}" ElementStyle="{StaticResource CellMuted}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
