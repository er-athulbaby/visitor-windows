<UserControl x:Class="ServiceGatePass.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:T 'From'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="FromDate" Width="150" Margin="0,0,12,0"/>
            <TextBlock Text="{l:T 'To'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="ToDate" Width="150" Margin="0,0,12,0"/>
            <TextBlock Text="{l:T 'Search'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="180" Margin="0,0,12,0"/>
            <ComboBox x:Name="LocationBox" Width="180" DisplayMemberPath="Display" SelectedValuePath="Id" Margin="0,0,12,0"/>
            <TextBlock Text="{l:T 'Company'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CompanyBox" Width="160" Margin="0,0,12,0"/>
            <Button Content="{l:T 'Show'}" Click="Show_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{l:T 'Export CSV'}" Click="Export_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{l:T 'Print'}" Click="Print_Click" Padding="12,4"/>
        </WrapPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{l:T 'CPR'}" Binding="{Binding Cpr}"/>
                <DataGridTextColumn Header="{l:T 'Location'}" Binding="{Binding Location}"/>
                <DataGridTextColumn Header="{l:T 'Company'}" Binding="{Binding Company}"/>
                <DataGridTextColumn Header="{l:T 'Note'}" Binding="{Binding Note}"/>
                <DataGridTextColumn Header="{l:T 'Badge #'}" Binding="{Binding BadgeNo}"/>
                <DataGridTextColumn Header="{l:T 'Slot #'}" Binding="{Binding SlotNo}"/>
                <DataGridTextColumn Header="{l:T 'In'}" Binding="{Binding CheckInAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                <DataGridTextColumn Header="{l:T 'Out'}" Binding="{Binding CheckOutAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                <DataGridTextColumn Header="{l:T 'Checked in by'}" Binding="{Binding CheckInBy}"/>
                <DataGridTextColumn Header="{l:T 'Checked out by'}" Binding="{Binding CheckOutBy}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
