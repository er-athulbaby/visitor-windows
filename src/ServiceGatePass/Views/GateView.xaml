<UserControl x:Class="ServiceGatePass.Views.GateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass"
             PreviewKeyDown="View_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel KeyDown="CheckInPanel_KeyDown">
                <TextBlock Text="{l:T 'Check in'}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <Image x:Name="Photo" FlowDirection="LeftToRight" DockPanel.Dock="Right" Width="90" Height="110" Stretch="Uniform"/>
                    <StackPanel>
                        <Button x:Name="ReadButton" Content="{l:T 'Read card (F2)'}" Click="ReadCard_Click" Padding="16,10" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ReaderMessage" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{l:T 'CPR'}"/>
                <TextBox x:Name="Cpr" MaxLength="9" LostFocus="Cpr_LostFocus"/>
                <TextBlock Text="{l:T 'Name'}" Margin="0,8,0,0"/>
                <TextBox x:Name="NameEn"/>
                <TextBlock x:Name="NameArText" Margin="0,4,0,0"/>
                <TextBlock Text="{l:T 'Location'}" Margin="0,8,0,0"/>
                <ListBox x:Name="Locations" DisplayMemberPath="Display" SelectedValuePath="Id" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="Margin" Value="0,0,6,6"/>
                            <Setter Property="BorderBrush" Value="Gray"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Text="{l:T 'Company'}" Margin="0,8,0,0"/>
                <TextBox x:Name="Company"/>
                <TextBlock Text="{l:T 'Note'}" Margin="0,8,0,0"/>
                <TextBox x:Name="Note"/>
                <StackPanel x:Name="BadgePanel" Margin="0,8,0,0">
                    <TextBlock Text="{l:T 'Badge #'}"/>
                    <TextBox x:Name="Badge" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="SlotPanel" Margin="0,8,0,0">
                    <TextBlock Text="{l:T 'Slot #'}"/>
                    <ComboBox x:Name="Slot" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock x:Name="CheckInMessage" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="{l:T 'Check in (Enter)'}" Click="CheckIn_Click" Padding="16,12" Margin="0,8,0,0" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{l:T 'Inside now'}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="Counter" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                <TextBlock Text="{l:T 'Search'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="Search" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{l:T 'Check out'}" Click="CheckOut_Click" Padding="16,12" DockPanel.Dock="Right" FontWeight="Bold"/>
                <TextBlock x:Name="CheckOutMessage" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <DataGrid x:Name="InsideGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{l:T 'Location'}" Binding="{Binding Location}"/>
                    <DataGridTextColumn Header="{l:T 'In'}" Binding="{Binding CheckInAt, StringFormat=HH:mm}"/>
                    <DataGridTextColumn Header="{l:T 'Duration'}" Binding="{Binding Duration}"/>
                    <DataGridTextColumn x:Name="BadgeColumn" Header="{l:T 'Badge #'}" Binding="{Binding BadgeNo}"/>
                    <DataGridTextColumn x:Name="SlotColumn" Header="{l:T 'Slot #'}" Binding="{Binding SlotNo}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
