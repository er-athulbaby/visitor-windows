<UserControl x:Class="ServiceGatePass.Views.GateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ServiceGatePass"
             xmlns:v="clr-namespace:ServiceGatePass.Views"
             PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <v:AvatarBrushConverter x:Key="AvatarBrush"/>
    </UserControl.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header: title, date and the three counters -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Inside now'}" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="InsideCount" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileAmber}" Margin="12,0">
                    <StackPanel>
                        <TextBlock Text="{l:T 'CPR cards held'}" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="CardsHeldCount" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Visits today'}" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="VisitsTodayCount" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Service gate'}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="DateLine" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="420"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Check in ===== -->
            <Border Style="{StaticResource Card}">
                <DockPanel KeyDown="CheckInPanel_KeyDown">
                    <TextBlock DockPanel.Dock="Top" Text="{l:T 'Check in'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <DockPanel DataContext="{Binding ElementName=CheckInMessage}">
                            <Path Style="{StaticResource MessageIcon}"/>
                            <TextBlock x:Name="CheckInMessage" Style="{StaticResource MessageText}" Margin="0,0,0,10"/>
                        </DockPanel>
                        <Button Style="{StaticResource LargePrimaryButton}" Click="CheckIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Check in'}" VerticalAlignment="Center"/>
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="#80FFFFFF" Padding="6,1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Enter" FontSize="12" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0" Focusable="False">
                        <StackPanel>
                            <Button x:Name="ReadButton" Style="{StaticResource ReadCardButton}" Click="ReadCard_Click">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}"
                                            TextElement.Foreground="White" Margin="0,0,14,0">
                                        <Viewbox Width="22" Height="22">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCard}"/>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="10,0,0,0">
                                        <TextBlock Text="F2"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{l:T 'Read CPR card'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OnTintBrush}"/>
                                        <TextBlock Text="{l:T 'Insert the card in the reader, then press F2'}" FontSize="13" FontWeight="Normal"
                                                   Foreground="{StaticResource OnTintSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <TextBlock x:Name="ReaderMessage" Style="{StaticResource ErrorText}" Margin="2,8,0,0"/>

                            <!-- Photo + identity -->
                            <DockPanel Margin="0,14,0,0">
                                <Grid DockPanel.Dock="Left" Width="78" Height="96" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Border CornerRadius="10" Background="{StaticResource SubtleFillBrush}"/>
                                    <Viewbox Width="30" Height="30" TextElement.Foreground="#9AA8B5">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPerson}" StrokeThickness="1.6"/>
                                    </Viewbox>
                                    <Image x:Name="Photo" FlowDirection="LeftToRight" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,78,96" RadiusX="10" RadiusY="10"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'CPR'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="Cpr" MaxLength="9" FontSize="15" FontWeight="SemiBold"
                                                 LostFocus="Cpr_LostFocus" TextChanged="Cpr_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T 'Company'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="Company"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="{l:T 'Name'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NameEn" FontSize="15" FontWeight="Medium"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" MinHeight="24">
                                        <Border x:Name="ReturningChip" DockPanel.Dock="Right" Style="{StaticResource Pill}" Visibility="Collapsed" Margin="8,0,0,0">
                                            <TextBlock x:Name="ReturningText"/>
                                        </Border>
                                        <TextBlock x:Name="NameArText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>

                            <!-- Location tiles -->
                            <TextBlock Text="{l:T 'Location'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                            <ListBox x:Name="Locations" Style="{StaticResource PlainList}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                     ItemContainerStyle="{StaticResource LocationTile}" Margin="0,0,-8,-8">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <!-- Note, badge, slot -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Note'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="Note"/>
                                </StackPanel>
                                <StackPanel x:Name="BadgePanel" Grid.Column="1" Width="110" Margin="10,0,0,0">
                                    <TextBlock Text="{l:T 'Badge #'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="Badge"/>
                                </StackPanel>
                                <StackPanel x:Name="SlotPanel" Grid.Column="2" Width="110" Margin="10,0,0,0">
                                    <TextBlock Text="{l:T 'Card slot'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="Slot" FontWeight="SemiBold" MaxDropDownHeight="260"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Inside now ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBox x:Name="Search" DockPanel.Dock="Right" Width="280" Style="{StaticResource SearchBox}"
                                 Tag="{l:T 'Name, CPR, badge or slot'}" AutomationProperties.Name="{l:T 'Search'}"
                                 TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                        <TextBlock Text="{l:T 'Inside now'}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LargeDarkButton}" Content="{l:T 'Check out · return card'}"
                                    Click="CheckOut_Click" Margin="12,0,0,0"/>
                            <DockPanel VerticalAlignment="Center" DataContext="{Binding ElementName=CheckOutMessage}">
                                <Path Style="{StaticResource MessageIcon}"/>
                                <TextBlock x:Name="CheckOutMessage" Style="{StaticResource MessageText}"/>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="InsideGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              RowStyle="{StaticResource CardRow}" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T 'Visitor'}" Width="2.4*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center">
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"
                                                    Background="{Binding Initials, Converter={StaticResource AvatarBrush}}">
                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding Initials, Converter={StaticResource AvatarBrush}, ConverterParameter=fg}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Company}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Location'}" Binding="{Binding Location}" Width="1.3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="{l:T 'In'}" Binding="{Binding CheckInAt, StringFormat=HH:mm}" Width="0.8*" ElementStyle="{StaticResource CellMuted}"/>
                            <DataGridTextColumn Header="{l:T 'Duration'}" Binding="{Binding Duration}" Width="0.9*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn x:Name="BadgeColumn" Header="{l:T 'Badge #'}" Binding="{Binding BadgeNo}" Width="0.7*" ElementStyle="{StaticResource CellNumber}"/>
                            <DataGridTextColumn x:Name="SlotColumn" Header="{l:T 'Slot'}" Binding="{Binding SlotNo}" Width="0.6*" ElementStyle="{StaticResource CellNumber}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
